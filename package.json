{
  "name": "dymension",
  "private": true,
  "type": "module",
  "workspaces": [
    "live-bridge",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev -w games/pump-it",
    "bridge": "npm run start -w live-bridge",
    "bridge:sim": "npm run start -w live-bridge -- --sim",
    "sim": "node live-bridge/bin/sim.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
